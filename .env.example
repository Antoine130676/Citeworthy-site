# The free teaser and paid-report flows are delivered by the Hermes agent
# (technical-health + client-reporting + himalaya / account-manager skills),
# not by this app directly — this app just relays HMAC-signed events into
# Hermes's webhook gateway. Copy this file to .env.local and fill in real
# values — .env.local is gitignored.

# Where the Hermes gateway is listening. Defaults to localhost, which only
# works if this app and Hermes run on the same machine/network. If the site
# is ever deployed elsewhere, Hermes needs to be reachable from there too
# (see `hermes gateway enroll` for a relay connector, or a tunnel).
HERMES_GATEWAY_URL=http://localhost:8644

# Per-subscription HMAC secrets, printed when the subscription was created
# with `hermes webhook subscribe <name>`. Regenerate with:
#   hermes webhook list
HERMES_TEASER_WEBHOOK_SECRET=your-teaser-subscription-secret
HERMES_PAYMENT_WEBHOOK_SECRET=your-payment-subscription-secret

# Used to build absolute links inside emails. Change once the domain is live;
# https://citeworthy.ai is the default if unset.
NEXT_PUBLIC_SITE_URL=https://citeworthy.ai
